###GDP[2]

dGPD2 = function(x,g,b){
  (1/b)*(1+x/(g*b))^(-g-1)
}
dGPD2(0.1,0.1,2)


#beta = shape
#gamma = scalw

neglogLGDP2 = function(params){
  -sum(log(dGPD2(x=w,params[1],params[2])))
}

Guess = c(1,EW)

MLE_GPD2 = nlm(neglogLGDP2,p=Guess,typsize = Guess)
MLE_GPD2

Guess2 = c(MLE_GPD2$estimate[1],MLE_GPD2$estimate[2])

MLE_GPD2_2 = nlm(neglogLGDP2,p=Guess2,typsize = Guess2)
MLE_GPD2_2

#((1-probs)^(1/-g)-1)*(g*b)

rGPD2 = function(n,g,b){
  ((1-runif(n=n,min=0,max=1))^(-1/g)-1)*(g*b)
}
wsim =rGPD2(NumSim,MLE_GPD2$estimate[1],MLE_GPD2$estimate[2])
qqplot(w,wsim,ylim=c(0,0.6))
abline(0,1)

