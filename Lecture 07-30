data = read.csv("//mcsfs01//users$//2024974525//Downloads//Data.csv")

returns =data$Return

plot(density(returns))

EX=mean(returns)
VarX = var(returns)
sdx =sd(returns)

negLogL =function(params){
  -sum(log(dnorm(returns,params[1],params[2])))
}

MLENorm = nlm(negLogL, p =c(EX,sdx), typsize = c(EX,sdx))
MLENorm

Best_Mu = MLENorm$estimate[1]
Best_sigma = MLENorm$estimate[2]
Best_Mu;Best_sigma

NumSim = 10^5
NormSim =rnorm(NumSim,Best_Mu,Best_sigma)
lines(density(NormSim), lty=2, col="red")

qqplot(returns,NormSim)
abline(0,1)

pp=ppoints(length(returns))

ReturnQ = quantile(returns,pp)
simQ = quantile(NormSim,pp)
plot(ReturnQ,simQ)
abline(0,1)

#Threshold exceedance method

M =quantile(returns,0.8)
M

