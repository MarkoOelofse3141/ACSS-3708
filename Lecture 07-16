# IF page 109 is correct, how different is retirement prob with vs without morality projections


ax = function(x){
  ifelse(x<60,0.13, ifelse(x>110,1,1-0.87*((110-x)/50)))
}
plot(Ages, ax(Ages))


fx = function(x){
  ifelse(x<60,0.55,ifelse(x>110,0.29,0.55*((110-x)/50)+0.29*((x-60)/50)))
}

plot(Ages,fx(Ages))

RedF = function(x,t){
  ax(x) + (1-ax(x))*(1-fx(x))^(t/20)
}

ts = seq(0,100,1)
RedFagelocked = RedF(x =21, t=ts)
plot(ts, RedFagelocked)

RedFtlocked = RedF(x =Ages, t= 20)
