rm(list=ls())
set.seed(20)

NumClaims=10*12*100
mu=8
sigma=1.2
Claims=rlnorm(NumClaims,mu,sigma)
plot(density(Claims))

Month=rep(seq(1,120,1),100)
head(cbind(Month,Claims),100)
max(Claims[Month==1])

## Extract the BlockMax data, the maximum claim in each month
NumBlocks=120
BlockMax= vector(length = NumBlocks)
for (i in 1:NumBlocks){
  BlockMax[i]=max(Claims[Month==i])
}

lines(density(BlockMax))

## GUMBEL GEV

DGompertz=function(x,a,b){
  1/b*exp(-(x-a)/b)*exp(-exp(-(x-a)/b))
}

DGompertz(110,110,1)

EBlockMax=mean(BlockMax)
sdBlockMax=sd(BlockMax)

negLogL=function(params){
  -sum(log(DGompertz(x=BlockMax,params[1],params[2])))
}

Guess=c(EBlockMax,sdBlockMax)

MLE=nlm(negLogL,p=Guess,typsize=Guess)
MLE

BestA=MLE$estimate[1]
BestB=MLE$estimate[2]

xs=seq(0,400*10^3,1000)
ys=DGompertz(xs,BestA,BestB)
lines(xs,ys,col="red")

## QQ Plot

qGompertz=function(p,a,b){
  a-b*log(-log(p))
}

qGompertz(0.5,BestA,BestB)

Qs=ppoints(NumBlocks)

DataQs=quantile(BlockMax,Qs)

cbind(DataQs,sort(BlockMax))

QsGompertz=qGompertz(Qs,BestA,BestB)

cbind(Qs,QsGompertz)

qqplot(DataQs,BlockMax)

abline(0,1)

plot(DataQs,QsGompertz)
abline(0,1)

##
rGompertz=function(n,a,b){
  qGompertz(p=runif(n,0,1),a,b)
}
NumSim=10^6

BlockMaxSim=rGompertz(NumSim,BestA,BestB)
qqplot(BlockMax,BlockMaxSim)
abline(0,1)

